# Copy this file to .env and fill in YOUR OWN free keys. Never commit .env.
# Rate limits are per account — do not share one key across the whole group.

# Required — free at https://aistudio.google.com/apikey (no card)
GOOGLE_API_KEY=

# Optional — web agent (F4), skips gracefully if unset. Free at https://tavily.com (no card)
TAVILY_API_KEY=

# Optional — observability (F12). Free at https://cloud.langfuse.com (no card)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Model names (defaults shown)
LLM_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004

# Local paths (defaults shown, usually no need to change)
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=fin01_docs
SQLITE_DB_PATH=./data/company.db

# Graph safety limits
RECURSION_LIMIT=15
MAX_REVISIONS=2
